#include <bits/stdc++.h>
using namespace std;
void solve(){
  int ch,bx;cin>>ch>>bx;
  vector<int> chw(ch+1),chl(ch+1),bxw(bx+1),bxl(bx+1);
    vector <pair<int,int>> wv;
    wv.reserve(ch + bx);
  for(int i=1;i<=ch;i++) {
    int choc; cin>>choc;
    wv.emplace_back(make_pair(choc,-i));
  }
  for(int i=1;i<=ch;i++) cin>>chl[i];
   for(int i=1;i<=bx;i++) {
    int boxw; cin>>boxw;
    wv.emplace_back(make_pair(boxw,i));
   }
    for(int i=1;i<=bx;i++) cin>>bxl[i];
    sort(wv.begin(),wv.end(),greater<>());
    multiset<int> ms;
    for(auto[w,idx]:wv){
      if(idx>0){
  ms.insert(bxl[idx]);
      }else{
        auto it=ms.lower_bound(chl[-idx]);
        if(it!=ms.end()){
          ms.erase(it);
        }else{
          cout<<"No"; return;
        }
      }
    }
    cout<<"Yes";
}
int main() {
    solve();
    return 0;
}
